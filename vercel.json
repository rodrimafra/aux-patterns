{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "tdm-reservation", "value": "1" },
        { "key": "tdm-policy", "value": "https://aux-patterns.vercel.app/ai-policy" },
        { "key": "X-Robots-Tag", "value": "noai, noimageai" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/tdmrep.json",
      "destination": "/well-known/tdmrep.json"
    }
  ]
}
